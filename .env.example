# ==================================================
# Digital Dark Spot Environment Configuration
# ==================================================

# AI Provider Configuration (Google Gemini / OpenAI)
# If left empty, Digital Dark Spot operates seamlessly in Local Deterministic Demo Mode
GEMINI_API_KEY=
OPENAI_API_KEY=
AI_MODEL=gemini-2.5-flash

# Database Configuration (SQLite by default, compatible with PostgreSQL)
DATABASE_URL=sqlite:///./digital_dark_spot.db
# For PostgreSQL:
# DATABASE_URL=postgresql://user:password@localhost:5432/digital_dark_spot

# Security Secret Key
SECRET_KEY=digital-dark-spot-super-secret-key-2026-development

# SMTP Email Configuration (Optional - for real email OTP delivery)
# If unconfigured, the application runs in Local Demo Mode with instant verification codes
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAILS_FROM_EMAIL=
